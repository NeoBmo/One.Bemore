---
import { POST_TYPES, SITE } from '../consts';
import { postUrl, titleTransition, type Post } from '../lib/blog';
import { formatDate } from '../lib/posts';
import '../styles/prose.css';
import Page from './Page.astro';

interface Props {
  post: Post;
  edited?: Date;
  previous?: Post;
  next?: Post;
}

const { post, edited, previous, next } = Astro.props;
const { title, description, pubDate, type, series, order, note } = post.data;
---

<Page title={title} description={description} type="article" header="post">
  <div class="post-shell">
  <div class="reading-progress" aria-hidden="true" data-progress></div>
  <article class="post">
    <header class="post__header">
      <p class="post__type" data-tone={type}>
        <a class="ink-link" href={`/blog/?tipo=${type}`}>{POST_TYPES[type].label}</a>
        {series && <span>· {series}, lección {order}</span>}
      </p>
      <h1 style={`view-transition-name: ${titleTransition(post)}`}>{title}</h1>
      <p class="post__dates">
        Escrito el <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {
          edited && (
            <>
              <span aria-hidden="true"> · </span>editado el{' '}
              <time datetime={edited.toISOString()}>{formatDate(edited)}</time>
            </>
          )
        }
      </p>
    </header>

    <div class="prose">
      <slot />
    </div>

    <footer class="post__footer">
      {
        (previous || next) && (
          <nav class="post__nav" aria-label={series ? `Lecciones de ${series}` : 'Más artículos'}>
            {previous && (
              <a class="post__nav-link press" href={postUrl(previous)} rel="prev">
                <span>{series ? 'Lección anterior' : 'Anterior'}</span>
                {previous.data.title}
              </a>
            )}
            {next && (
              <a class="post__nav-link post__nav-link--next press" href={postUrl(next)} rel="next">
                <span>{series ? 'Lección siguiente' : 'Siguiente'}</span>
                {next.data.title}
              </a>
            )}
          </nav>
        )
      }

      {/* Los comentarios llegan en la rama feat/comments y colgarán de esta sección. */}
      {
        note && (
          <section id="comentarios" class="thread" aria-labelledby="thread-title">
            <h2 id="thread-title" class="visually-hidden">Última anotación</h2>
            <div class="thread__note">
              <p class="thread__label">Última anotación</p>
              <p>{note}</p>
              <p class="thread__signature">— {SITE.author}</p>
            </div>
          </section>
        )
      }
    </footer>
  </article>
  </div>
</Page>

<style>
  .post__header {
    padding-block: clamp(2rem, 5vw, 4rem) 2.5rem;
  }

  .post__type {
    display: flex;
    gap: 0.5rem;
    color: var(--tone);
    font-size: var(--text-sm);
  }

  .post__header h1 {
    margin-top: 0.5rem;
    font-size: var(--text-title);
  }

  .post__dates {
    margin-top: 1rem;
    color: var(--color-meta);
    font-size: var(--text-sm);
  }

  .post__footer {
    margin-top: var(--space-section);
  }

  .post__nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
    padding-block: 2rem;
    border-block: 1px dashed var(--color-rule);
  }

  .post__nav-link {
    display: grid;
    gap: 0.25rem;
    font-family: var(--font-hand);
    font-weight: 700;
    text-decoration: none;
  }

  .post__nav-link span {
    color: var(--color-meta);
    font-family: var(--font-reading);
    font-size: var(--text-sm);
    font-weight: 400;
  }

  .post__nav-link--next {
    text-align: right;
  }

  /* La anotación es la raíz del hilo: los comentarios cuelgan de su línea. */
  .thread {
    margin-top: 3rem;
    padding-left: 1.5rem;
    border-left: 2px dashed var(--pink-700);
  }

  .thread__note {
    position: relative;
  }

  .thread__note::before {
    content: '';
    position: absolute;
    top: 0.55em;
    left: calc(-1.5rem - 7px);
    width: 12px;
    height: 12px;
    background: var(--color-accent);
    transform: rotate(45deg);
  }

  .thread__label {
    font-family: var(--font-hand);
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .thread__note > p + p {
    margin-top: 0.75rem;
  }

  .thread__signature {
    color: var(--color-accent);
    font-family: var(--font-hand);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* La barra avanza con el scroll en el hilo del compositor y solo se deja ver
     mientras la persona se desplaza; al detenerse se desvanece. */
  .reading-progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 5;
    height: 3px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    opacity: 0;
    transition: opacity 700ms ease;
  }

  .reading-progress[data-visible] {
    opacity: 1;
    transition-duration: 150ms;
  }

  /* La barra mide el texto, no la página: el nombre de la línea de tiempo nace
     en .prose y timeline-scope lo hace visible a la barra, que es su vecina. */
  .post-shell {
    timeline-scope: --article;
  }

  .prose {
    view-timeline: --article block;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .reading-progress {
        animation: reading-progress linear both;
        animation-timeline: --article;
        /* 0 %: el inicio del texto toca el borde superior.
           100 %: el final del texto toca el borde inferior, es decir, terminaste de leer. */
        animation-range: contain 0% contain 100%;
      }

      @keyframes reading-progress {
        to {
          transform: scaleX(1);
        }
      }
    }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  const prose = document.querySelector<HTMLElement>('.prose');
  let hideTimer = 0;

  // Si el texto cabe entero en pantalla no hay nada que medir: la barra se oculta.
  const fitsOnScreen = () => Boolean(prose && prose.offsetHeight <= window.innerHeight);

  window.addEventListener(
    'scroll',
    () => {
      if (!bar || fitsOnScreen()) return;
      bar.dataset.visible = '';
      clearTimeout(hideTimer);
      hideTimer = window.setTimeout(() => bar.removeAttribute('data-visible'), 900);
    },
    { passive: true },
  );
</script>
