---
// Cuando llegue el dibujo, va en src/assets/logo.svg y se pinta aquí junto al nombre.
---

<a class="logo press" href="/" aria-label="one.bmore, inicio">
  <span class="logo__mark" aria-hidden="true"></span>
  <span class="logo__name">one.bmore</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-hand);
    font-size: var(--text-lg);
    font-weight: 700;
    text-decoration: none;
  }

  .logo__mark {
    width: 0.7em;
    height: 0.7em;
    border-radius: 50%;
    background: var(--color-accent);
    transition: transform var(--duration-hover) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .logo:hover .logo__mark {
      transform: scale(1.25) rotate(-8deg);
    }
  }
</style>
