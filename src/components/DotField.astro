<div class="dot-field" aria-hidden="true">
  <div class="dot-field__glow" data-dot-glow></div>
  <div class="dot-field__sheet" data-dot-sheet></div>
</div>

<style>
  /* Tres capas: color tenue, luz móvil y una hoja negra perforada en cada punto.
     Solo se mueven la luz y la hoja, así que el navegador no repinta. */
  .dot-field {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    contain: strict;
    background: var(--color-dot);
  }

  .dot-field__glow {
    position: absolute;
    inset: -13rem auto auto -13rem;
    width: 26rem;
    height: 26rem;
    background: radial-gradient(circle closest-side, var(--color-accent), transparent);
    opacity: 0;
    transition: opacity 400ms ease;
    will-change: transform;
  }

  .dot-field__glow[data-active] {
    opacity: 1;
  }

  .dot-field__sheet {
    position: absolute;
    inset: 0 0 auto;
    height: calc(100% + var(--dot-period));
    background-image: radial-gradient(
      circle at center,
      transparent 1.25px,
      var(--color-paper) 1.75px
    );
    background-size: var(--dot-period) var(--dot-period);
    will-change: transform;
  }
</style>

<script>
  import { dotOffset, follow } from '../lib/dot-field';

  const sheet = document.querySelector<HTMLElement>('[data-dot-sheet]');
  const glow = document.querySelector<HTMLElement>('[data-dot-glow]');
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const finePointer = matchMedia('(hover: hover) and (pointer: fine)');

  let scrollFrame = 0;
  let glowFrame = 0;
  const light = { x: 0, y: 0, targetX: 0, targetY: 0, placed: false };

  const paintSheet = () => {
    scrollFrame = 0;
    if (!sheet) return;
    const offset = reducedMotion.matches ? 0 : dotOffset(window.scrollY);
    sheet.style.transform = `translate3d(0, ${offset}px, 0)`;
  };

  const requestSheet = () => {
    scrollFrame ||= requestAnimationFrame(paintSheet);
  };

  const paintGlow = () => {
    light.x = follow(light.x, light.targetX);
    light.y = follow(light.y, light.targetY);
    if (glow) glow.style.transform = `translate3d(${light.x}px, ${light.y}px, 0)`;
    const settled = light.x === light.targetX && light.y === light.targetY;
    glowFrame = settled ? 0 : requestAnimationFrame(paintGlow);
  };

  const onPointerMove = (event: PointerEvent) => {
    if (reducedMotion.matches || !finePointer.matches || !glow) return;
    light.targetX = event.clientX;
    light.targetY = event.clientY;
    // La primera vez la luz nace bajo el cursor en vez de cruzar la pantalla.
    if (!light.placed) {
      light.x = light.targetX;
      light.y = light.targetY;
      light.placed = true;
    }
    glow.dataset.active = '';
    glowFrame ||= requestAnimationFrame(paintGlow);
  };

  const hideGlow = () => glow?.removeAttribute('data-active');

  paintSheet();
  window.addEventListener('scroll', requestSheet, { passive: true });
  window.addEventListener('pageshow', paintSheet);
  window.addEventListener('pointermove', onPointerMove, { passive: true });
  document.documentElement.addEventListener('pointerleave', hideGlow);
  reducedMotion.addEventListener('change', () => {
    paintSheet();
    hideGlow();
  });
</script>
