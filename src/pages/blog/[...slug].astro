---
import { render } from 'astro:content';
import Post from '../../layouts/Post.astro';
import { getPosts, type Post as PostEntry } from '../../lib/blog';
import { lastEditDate } from '../../lib/git-dates';
import { chronologicalNeighbors, editedDate, seriesNeighbors } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => {
    const neighbors = post.data.series ? seriesNeighbors(post, posts) : chronologicalNeighbors(post, posts);
    const edited = editedDate(post.data.pubDate, post.data.updatedDate, lastEditDate(post.filePath));
    return { params: { slug: post.id }, props: { post, edited, ...neighbors } };
  });
}

interface Props {
  post: PostEntry;
  edited?: Date;
  previous?: PostEntry;
  next?: PostEntry;
}

const { post, edited, previous, next } = Astro.props;
const { Content } = await render(post);
---

<Post post={post} edited={edited} previous={previous} next={next}>
  <Content />
</Post>
