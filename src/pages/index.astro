---
import Page from '../layouts/Page.astro';
import { SITE } from '../consts';
---

<Page title={SITE.name} description={SITE.description}>
  <h1 class="rise" style="font-size: var(--text-title); padding-block: 6rem 2rem;">one.bmore</h1>
  <p class="rise" style="--order: 1">
    Muestra de identidad. El texto largo usa JetBrains Mono: <a href="#muestra">un enlace</a>,
    <strong>una palabra fuerte</strong> y <em>una cursiva</em>, con tildes, eñes y signos: ¿qué tal, mañana?
  </p>
  <p style="padding-block: 2rem"><a id="muestra" class="ink-link press" href="#contenido">Enlace con trazo</a></p>
  {Array.from({ length: 12 }, (_, index) => <p style="padding-block: 2.5rem">Párrafo {index + 1} para probar cómo los puntos se quedan atrás mientras el texto pasa cerca.</p>)}
</Page>
