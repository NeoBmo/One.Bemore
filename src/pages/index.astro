---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import { SiteDescription, SiteTitleHome } from "../consts";
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title={SiteTitleHome} description={SiteDescription} />
  </head>
  <body>
    <Header />
    <main>
      <section class="min-h-screen flex items-center py-24 sm:py-28">
        <div class="w-11/12 max-w-3xl mx-auto">
          <div class="text-center">
            <h1
              class="text-pink-400 text-3xl font-semibold animate-fade-up animate-duration-500 animate-ease-out"
            >
              1% mejor cada día
            </h1>
            <p
              class="mt-3 text-neutral-100 animate-fade-up animate-duration-500 animate-delay-100 animate-ease-out"
            >
              En este blog, encontrarás herramientas para el aprendizaje
              efectivo y el autodidactismo, descubriendo las claves para
              alcanzar tu máximo potencial.
            </p>
            <a
              href="/blog"
              class="inline-flex items-center justify-center px-3 py-1 mt-6 w-fit text-xl font-semibold underline text-pink-400 hover:scale-110 transition duration-300 ease-in-out animate-fade-up animate-duration-500 animate-delay-200 animate-ease-out"
            >
              Comenzar
            </a>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
