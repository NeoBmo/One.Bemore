---
import Page from '../layouts/Page.astro';
---

<Page title="Página no encontrada" description="Esta página no existe en one.bmore.">
  <section class="missing">
    <h1 class="rise">Esta hoja está en blanco.</h1>
    <p class="rise" style="--order: 1">La página que buscas no existe o cambió de lugar.</p>
    <p class="rise" style="--order: 2">
      <a class="ink-link press" href="/blog/">Ir al archivo</a>
    </p>
  </section>
</Page>

<style>
  .missing {
    display: grid;
    gap: 1rem;
    padding-block: clamp(3rem, 10vw, 7rem);
  }

  .missing h1 {
    font-size: var(--text-title);
  }
</style>
