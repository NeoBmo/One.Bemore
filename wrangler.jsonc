// Worker de One.Bemore en Cloudflare. En esta rama el sitio es solo estático: sin esta
// configuración, las vistas previas de rama («wrangler versions upload») no saben qué subir.
// La rama del servidor de comentarios reemplaza este archivo por el del adaptador.
{
	"name": "one-bemore",
	"compatibility_date": "2026-11-16",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	}
}
